    # ── Uptime Kuma ──────────────────────────────────────────
    # Must use handle_path to strip the /status prefix before
    # forwarding to Uptime Kuma, because Kuma listens at /
    # internally even when BASE_PATH=/status is set.
    # header_up Host preserves the original host for Kuma.
    # transport http / versions enables websocket upgrades
    # needed for the live dashboard.
    handle /status* {
        reverse_proxy uptime-kuma:3001 {
            header_up Host {host}
            transport http {
                versions h1 h2
            }
        }
    }

    # ── StatusPulse app ──────────────────────────────────────
    handle {
        reverse_proxy app:8000
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}