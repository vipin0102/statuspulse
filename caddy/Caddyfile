# =====================================================
# MAIN APPLICATION
# =====================================================

https://av-lap-pg0441tk.taildb17d2.ts.net {

    encode gzip

    reverse_proxy app:8000

    # -------------------------------------------------
    # SECURITY HEADERS
    # -------------------------------------------------

    header {

        # Enforce HTTPS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"

        # Prevent clickjacking
        X-Frame-Options "DENY"

        # XSS filter
        X-XSS-Protection "1; mode=block"

        # Referrer control
        Referrer-Policy "strict-origin-when-cross-origin"

        # Disable browser APIs
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Hide Caddy version
        -Server

        # Content Security Policy
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss:;"
    }

    # -------------------------------------------------
    # BASIC RATE LIMIT / REQUEST LIMIT
    # -------------------------------------------------

    request_body {
        max_size 10MB
    }

    # -------------------------------------------------
    # ACCESS LOGGING
    # -------------------------------------------------

    log {
        output file /data/main-app-access.log
        format console
    }
}

# =====================================================
# UPTIME KUMA
# =====================================================

https://av-lap-pg0441tk.taildb17d2.ts.net:8443 {

    encode gzip

    reverse_proxy uptime-kuma:3001

    # -------------------------------------------------
    # SECURITY HEADERS
    # -------------------------------------------------

    header {

        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        X-Content-Type-Options "nosniff"

        X-Frame-Options "SAMEORIGIN"

        X-XSS-Protection "1; mode=block"

        Referrer-Policy "strict-origin-when-cross-origin"

        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        -Server
    }

    # -------------------------------------------------
    # REQUEST LIMITS
    # -------------------------------------------------

    request_body {
        max_size 5MB
    }

    # -------------------------------------------------
    # ACCESS LOGGING
    # -------------------------------------------------

    log {
        output file /data/uptime-kuma-access.log
        format console
    }
}